{
  "name": "inksight",
  "private": true,
  "version": "1.2.0",
  "description": "A local-first workspace for deep reading, visual notes, and knowledge mapping.",
  "author": "MrmoLabs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test": "vitest",
    "drawnix:sync:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\drawnix-sync.ps1 -Action status",
    "drawnix:sync:fetch": "powershell -ExecutionPolicy Bypass -File .\\scripts\\drawnix-sync.ps1 -Action fetch",
    "drawnix:sync:log": "powershell -ExecutionPolicy Bypass -File .\\scripts\\drawnix-sync.ps1 -Action log",
    "drawnix:sync:diff": "powershell -ExecutionPolicy Bypass -File .\\scripts\\drawnix-sync.ps1 -Action diff",
    "drawnix:sync:all": "powershell -ExecutionPolicy Bypass -File .\\scripts\\drawnix-sync.ps1 -Action all"
  },
  "build": {
    "appId": "com.inksight.app",
    "productName": "InkSight",
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    },
    "buildVersion": "1.2.0",
    "asar": true,
    "files": [
      "dist/**/*",
      "!dist/win-unpacked",
      "!dist/*.exe",
      "!dist/*.yml",
      "!dist/*.yaml",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@plait-board/markdown-to-drawnix": "^0.0.7",
    "@plait-board/mermaid-to-drawnix": "^0.0.7",
    "@plait/common": "^0.91.1",
    "@plait/core": "^0.91.1",
    "@plait/draw": "^0.91.1",
    "@plait/layouts": "^0.91.1",
    "@plait/mind": "^0.91.1",
    "@plait/text-plugins": "^0.91.1",
    "ahooks": "^3.9.6",
    "browser-fs-access": "^0.38.0",
    "classnames": "^2.5.1",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "immer": "10.0.4",
    "is-hotkey": "^0.2.0",
    "laser-pen": "^1.0.1",
    "marked": "^12.0.0",
    "mobile-detect": "^1.4.5",
    "open-color": "^1.9.1",
    "pdfjs-dist": "^4.0.379",
    "points-on-curve": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "roughjs": "^4.6.6",
    "sass": "^1.104.0",
    "slate": "^0.118.1",
    "slate-dom": "^0.119.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.119.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    },
    "@plait-board/mermaid-to-drawnix": {
      "mermaid": "10.9.8"
    },
    "mermaid": {
      "dompurify": "3.4.15",
      "uuid": "14.0.2"
    }
  }
}
